  <Source dwd:design-time-name="5745c77f-6c70-457d-9563-31eba257e988">
    <DataSourceViewID>Warehouse Travel Agency</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="6f16a925-9fcf-4d5b-9b4e-c787f9e2b598">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Średnia Wartość Rezerwacji]
 AS [Measures].[Kwota Transakcji] / [Measures].[Rezerwacja F Count], 
FORMAT_STRING = "Currency", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Rezerwacja F'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Średnia Cena Turnusu]
 AS [Measures].[Cena Turnusu] / [Measures].[Rezerwacja F Count], 
FORMAT_STRING = "Currency", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Rezerwacja F'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Koszt na klikniecie]
 AS [Measures].[Koszt Kampanii] / [Measures].[Liczba Klikniec], 
FORMAT_STRING = "Currency", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Kampania F'  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="21f079e8-9be4-4a5d-a1da-a159c4ff8e2d">
      <ID>KPI</ID>
      <Name>Liczba rezerwacji</Name>
      <AssociatedMeasureGroupID>Rezerwacja F</AssociatedMeasureGroupID>
      <Value>[Measures].[Rezerwacja F Count]</Value>
      <Goal>([Measures].[Rezerwacja F Count], [Data D].[Miesiac].CurrentMember.PrevMember)*1.005</Goal>
      <Status>IIF([Measures].[Rezerwacja F Count]&gt;=([Measures].[Rezerwacja F Count], [Data D].[Miesiac].CurrentMember.PrevMember)*1.005,1,0)</Status>
      <Trend>([Measures].[Rezerwacja F Count], [Data D].[Miesiac].CurrentMember.PrevMember)*1.005</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="a016308b-ca0a-47d5-b39e-84647d64c647">
      <ID>KPI 1</ID>
      <Name>Średnia wartość rezerwacji</Name>
      <AssociatedMeasureGroupID>Rezerwacja F</AssociatedMeasureGroupID>
